# Variables de Entorno - MediSystem Backend
# Copia este archivo a .env y ajusta los valores para tu entorno

# Puerto del Servidor Node.js
PORT=3000

# Entorno (development, test, production)
NODE_ENV=development

# URL de conexión a la Base de Datos MySQL (Formato Prisma)
# Reemplaza root:@localhost:3306/medisystem por tus credenciales
DATABASE_URL="mysql://root:@localhost:3306/medisystem"

# Clave secreta para firmar los JSON Web Tokens (JWT)
# Cambia esto por un string seguro en producción
JWT_SECRET="super_secret_jwt_key_for_medisystem_2026"